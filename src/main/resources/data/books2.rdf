<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:user="http://example.org/users#"
    xmlns:book="http://example.org/books#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

  <book:Book rdf:about="http://example.org/books#MidnightLibrary">
    <book:title>The Midnight Library</book:title>
    <book:author>Matt Haig</book:author>
    <book:suitableFor>
      <book:ReadingLevel rdf:about="http://example.org/books#Intermediate">
        <rdfs:label>Intermediate</rdfs:label>
      </book:ReadingLevel>
    </book:suitableFor>
    <book:belongsToTheme>
      <book:Theme rdf:about="http://example.org/books#Fantasy">
        <rdfs:label>Fantasy</rdfs:label>
      </book:Theme>
    </book:belongsToTheme>
  </book:Book>

  <book:Book rdf:about="http://example.org/books#DarkMatter">
    <book:title>Dark Matter</book:title>
    <book:author>Blake Crouch</book:author>
    <book:suitableFor>
      <book:ReadingLevel rdf:about="http://example.org/books#Advanced">
        <rdfs:label>Advanced</rdfs:label>
      </book:ReadingLevel>
    </book:suitableFor>
    <book:belongsToTheme>
      <book:Theme rdf:about="http://example.org/books#ScienceFiction">
        <rdfs:label>Science Fiction</rdfs:label>
      </book:Theme>
    </book:belongsToTheme>
  </book:Book>

  <book:Book rdf:about="http://example.org/books#ThursdayMurderClub">
    <book:title>The Thursday Murder Club</book:title>
    <book:author>Richard Osman</book:author>
    <book:suitableFor>
      <book:ReadingLevel rdf:about="http://example.org/books#Beginner">
        <rdfs:label>Beginner</rdfs:label>
      </book:ReadingLevel>
    </book:suitableFor>
    <book:belongsToTheme>
      <book:Theme rdf:about="http://example.org/books#Mystery">
        <rdfs:label>Mystery</rdfs:label>
      </book:Theme>
    </book:belongsToTheme>
  </book:Book>

  <book:Book rdf:about="http://example.org/books#BraveNewWorld">
    <book:title>Brave New World</book:title>
    <book:author>Aldous Huxley</book:author>
    <book:suitableFor rdf:resource="http://example.org/books#Advanced"/>
    <book:belongsToTheme rdf:resource="http://example.org/books#ScienceFiction"/>
  </book:Book>

  <book:Book rdf:about="http://example.org/books#CrawdadsSing">
    <book:title>Where the Crawdads Sing</book:title>
    <book:author>Delia Owens</book:author>
    <book:suitableFor rdf:resource="http://example.org/books#Intermediate"/>
    <book:belongsToTheme rdf:resource="http://example.org/books#Mystery"/>
  </book:Book>

  <book:User rdf:about="http://example.org/users#Alice">
    <user:name>Alice</user:name>
    <user:hasReadingLevel rdf:resource="http://example.org/books#Intermediate"/>
    <user:prefersTheme rdf:resource="http://example.org/books#ScienceFiction"/>
  </book:User>

  <book:User rdf:about="http://example.org/users#Bob">
    <user:name>Bob</user:name>
    <user:hasReadingLevel rdf:resource="http://example.org/books#Beginner"/>
        <user:prefersTheme rdf:resource="http://example.org/books#Mystery"/>
  </book:User>

</rdf:RDF>
