<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:user="http://example.org/users#"
    xmlns:book="http://example.org/books#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
  <book:Book rdf:about="http://example.org/books#HP">
    <book:suitableFor>
      <book:ReadingLevel rdf:about="http://example.org/books#Beginner">
        <rdfs:label>Beginner</rdfs:label>
      </book:ReadingLevel>
    </book:suitableFor>
    <book:belongsToTheme rdf:resource="http://example.org/books#Murder"/>
    <book:belongsToTheme>
      <book:Theme rdf:about="http://example.org/books#Mystery">
        <rdfs:label>Mystery</rdfs:label>
      </book:Theme>
    </book:belongsToTheme>
    <book:belongsToTheme>
      <book:Theme rdf:about="http://example.org/books#Fantasy">
        <rdfs:label>Fantasy</rdfs:label>
      </book:Theme>
    </book:belongsToTheme>
    <book:author>J.K. Rowling</book:author>
    <book:title>Harry Potter and the Sorcerer's Stone</book:title>
  </book:Book>
  <book:Book rdf:about="http://example.org/books#NameOfTheWind">
    <book:title>The Name of the Wind</book:title>
    <book:author>Patrick Rothfuss</book:author>
    <book:suitableFor>
      <book:ReadingLevel rdf:about="http://example.org/books#Intermediate">
        <rdfs:label>Intermediate</rdfs:label>
      </book:ReadingLevel>
    </book:suitableFor>
    <book:belongsToTheme rdf:resource="http://example.org/books#Fantasy"/>
  </book:Book>
  <book:Book rdf:about="http://example.org/books#TheMartian">
    <book:title>The Martian</book:title>
    <book:author>Gigel</book:author>
    <book:suitableFor rdf:resource="http://example.org/books#Intermediate"/>
    <book:belongsToTheme>
      <book:Theme rdf:about="http://example.org/books#ScienceFiction">
        <rdfs:label>Science Fiction</rdfs:label>
      </book:Theme>
    </book:belongsToTheme>
  </book:Book>
  <book:Book rdf:about="http://example.org/books#TheSilentPatient">
    <book:title>The Silent Patient</book:title>
    <book:author>Alex Michaelides</book:author>
    <book:suitableFor rdf:resource="http://example.org/books#Intermediate"/>
    <book:belongsToTheme rdf:resource="http://example.org/books#Mystery"/>
  </book:Book>
  <book:Book rdf:about="http://example.org/books#Foundation">
    <book:title>Foundation</book:title>
    <book:author>Isaac Asimov</book:author>
    <book:suitableFor>
      <book:ReadingLevel rdf:about="http://example.org/books#Advanced">
        <rdfs:label>Advanced</rdfs:label>
      </book:ReadingLevel>
    </book:suitableFor>
    <book:belongsToTheme rdf:resource="http://example.org/books#ScienceFiction"/>
  </book:Book>
  <book:User rdf:about="http://example.org/users#Maria">
    <user:name>Maria</user:name>
    <user:hasReadingLevel rdf:resource="http://example.org/books#Intermediate"/>
    <user:prefersTheme rdf:resource="http://example.org/books#Fantasy"/>
  </book:User>
  <book:Book rdf:about="http://example.org/books#GoneGirl">
    <book:title>Gone Girl</book:title>
    <book:author>Gillian Flynn</book:author>
    <book:suitableFor rdf:resource="http://example.org/books#Advanced"/>
    <book:belongsToTheme>
      <book:Theme rdf:about="http://example.org/books#Thriller">
        <rdfs:label>Thriller</rdfs:label>
      </book:Theme>
    </book:belongsToTheme>
  </book:Book>
  <book:User rdf:about="http://example.org/users#Codrin">
    <user:name>Codrin</user:name>
    <user:hasReadingLevel rdf:resource="http://example.org/books#Beginner"/>
    <user:prefersTheme rdf:resource="http://example.org/books#Mystery"/>
  </book:User>
  <book:Book rdf:about="http://example.org/books#Neuromancer">
    <book:title>Neuromancer</book:title>
    <book:author>William Gibson</book:author>
    <book:suitableFor rdf:resource="http://example.org/books#Advanced"/>
    <book:belongsToTheme rdf:resource="http://example.org/books#ScienceFiction"/>
  </book:Book>
  <book:Book rdf:about="http://example.org/books#DaVinciCode">
    <book:title>The Da Vinci Code</book:title>
    <book:author>Dan Brown</book:author>
    <book:suitableFor rdf:resource="http://example.org/books#Intermediate"/>
    <book:belongsToTheme rdf:resource="http://example.org/books#Thriller"/>
  </book:Book>
  <book:Book rdf:about="http://example.org/books#1984">
    <book:title>Nineteen Eighty-Four</book:title>
    <book:author>George Orwell</book:author>
    <book:suitableFor rdf:resource="http://example.org/books#Advanced"/>
    <book:belongsToTheme rdf:resource="http://example.org/books#ScienceFiction"/>
  </book:Book>
  <book:Book rdf:about="http://example.org/books#AndThenThereWereNone">
    <book:title>And Then There Were None</book:title>
    <book:author>Agatha Christie</book:author>
    <book:suitableFor rdf:resource="http://example.org/books#Intermediate"/>
    <book:belongsToTheme rdf:resource="http://example.org/books#Mystery"/>
  </book:Book>
  <book:Book rdf:about="http://example.org/books#HungerGames">
    <book:title>Hunger Games</book:title>
    <book:author>Suzanne Collins</book:author>
    <book:suitableFor rdf:resource="http://example.org/books#Beginner"/>
    <book:belongsToTheme rdf:resource="http://example.org/books#ScienceFiction"/>
  </book:Book>
  <book:Book rdf:about="http://example.org/books#Dune">
    <book:title>Dune</book:title>
    <book:author>Frank Herbert</book:author>
    <book:suitableFor rdf:resource="http://example.org/books#Advanced"/>
    <book:belongsToTheme rdf:resource="http://example.org/books#ScienceFiction"/>
  </book:Book>
  <book:Book rdf:about="http://example.org/books#TheHobbit">
    <book:title>The Hobbit</book:title>
    <book:author>J.R.R. Tolkien</book:author>
    <book:suitableFor rdf:resource="http://example.org/books#Intermediate"/>
    <book:belongsToTheme rdf:resource="http://example.org/books#Fantasy"/>
  </book:Book>
  <book:Book rdf:about="http://example.org/books#ProjectHailMary">
    <book:title>Project Hail Mary</book:title>
    <book:author>Andy Weir</book:author>
    <book:suitableFor rdf:resource="http://example.org/books#Intermediate"/>
    <book:belongsToTheme rdf:resource="http://example.org/books#ScienceFiction"/>
  </book:Book>
  <book:Book rdf:about="http://example.org/books#StudyInScarlet">
    <book:title>A Study in Scarlet</book:title>
    <book:author>Arthur Conan Doyle</book:author>
    <book:suitableFor rdf:resource="http://example.org/books#Intermediate"/>
    <book:belongsToTheme rdf:resource="http://example.org/books#Mystery"/>
  </book:Book>
</rdf:RDF>
